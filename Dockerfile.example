FROM python:3.12-slim-bookworm

# Example Dockerfile (DO NOT hardcode secrets here)
# Use --build-arg for build-time values or pass runtime env vars with `docker run -e`.

# Build-time args (placeholders)
ARG API_KEY_ROBOFLOW
ARG AWS_ENDPOINT_URL
ARG AWS_S3_ENDPOINT_URL
ARG AWS_ACCESS_KEY_ID
ARG AWS_SECRET_ACCESS_KEY
ARG AWS_DEFAULT_REGION
ARG WANDB_API_KEY

# Non-sensitive defaults
ENV BRONZE_DIR="./bronze" \
    SILVER_DIR="./silver" \
    METADATA_SUBFOLDER="metadata" \
    IMAGES_SUBFOLDER="images" \
    PROJECT_NAME="natural-vs-unnatural-images" \
    DATASET_NAME="natural-vs-unnatural-images-dataset" \
    BRONZE_BUCKET_NAME="natural-vs-unnatural-dataset" \
    BRONZE_FOLDER_PATH="bronze" \
    SILVER_BUCKET_NAME="natural-vs-unnatural-dataset" \
    SILVER_FOLDER_PATH="silver" \
    LABEL_STUDIO_INGESTION_BUCKET="label-studio-silver-data-ingestion" \
    BUCKET_PATH=""

ENV API_KEY_ROBOFLOW=${API_KEY_ROBOFLOW} \
    AWS_ENDPOINT_URL=${AWS_ENDPOINT_URL} \
    AWS_S3_ENDPOINT_URL=${AWS_S3_ENDPOINT_URL} \
    AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} \
    AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} \
    AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION} \
    WANDB_API_KEY=${WANDB_API_KEY}

RUN apt-get update && apt-get install -y \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# UV install (installs to /root/.local/bin)
ENV PATH="/root/.local/bin:$PATH"
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

WORKDIR /app
COPY . /app

# Init UV environment
RUN uv sync

CMD ["uv", "run", "pipeline_orchestrator.py"]

# Usage examples:
# Build without secrets (set only non-sensitive defaults):
#   docker build -t data-pipeline:local .
# Build with build-args (not recommended for secrets):
#   docker build \
#     --build-arg API_KEY_ROBOFLOW=your_key \
#     --build-arg AWS_ACCESS_KEY_ID=AKIA... \
#     --build-arg AWS_SECRET_ACCESS_KEY=secret \
#     -t data-pipeline:local .
# Run and pass secrets at runtime instead of baking into image:
#   docker run --rm -e AWS_ACCESS_KEY_ID=... -e AWS_SECRET_ACCESS_KEY=... data-pipeline:local
